---
import { FLASK_URL } from '../../lib/urls';

export interface Props {
  restaurantName: string;
  whatsappPhone?: string;
}

const { restaurantName, whatsappPhone } = Astro.props;
const legalUrl = `${FLASK_URL}legal`;
---

<footer class="border-t border-border-subtle px-4 py-6 text-center text-sm text-ink-faint">
  <p class="text-xs">Menú operado por {restaurantName}</p>
  <nav aria-label="Legal" class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs">
    <a href={`${legalUrl}#terminos`} class="underline transition hover:text-accent">Términos y Condiciones</a>
    <a href={`${legalUrl}#privacidad`} class="underline transition hover:text-accent">Privacidad</a>
    <a href={`${legalUrl}#reembolsos`} class="underline transition hover:text-accent">Reembolsos</a>
  </nav>
  <p class="mt-3 text-xs">Plataforma: <strong class="font-semibold text-ink-muted">Velzia</strong> · Jhoan Rivera · NIT 100.275.521-5 · Riosucio, Caldas, Colombia</p>
</footer>
