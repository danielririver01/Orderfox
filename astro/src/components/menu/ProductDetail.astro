---
export interface Props {
  ordering: boolean;
}

const { ordering } = Astro.props;
---

<div
  id="product-detail"
  class="fixed right-0 top-0 z-40 h-full w-full max-w-md translate-x-full transform bg-card shadow-2xl transition-transform duration-300"
>
  <div class="flex h-full flex-col">
    <!-- Imagen -->
    <div class="relative max-h-[35vh] min-h-[180px] bg-card-hover sm:max-h-[45vh]" id="detail-image-container">
      <div
        id="detail-image-placeholder"
        class="flex h-full w-full items-center justify-center bg-accent-bg text-6xl font-bold text-accent"
      ></div>
      <img id="detail-image" class="hidden h-full w-full object-cover object-center" alt="" />
      <button
        id="close-detail"
        class="absolute right-3 top-3 rounded-full bg-base/70 p-2 shadow-lg backdrop-blur transition hover:bg-base"
        aria-label="Cerrar"
      >
        <svg class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Contenido -->
    <div class="flex-1 overflow-y-auto p-5" id="detail-body">
      <h2 class="font-display text-xl font-semibold text-ink" id="detail-name"></h2>
      <p class="mt-2 text-sm text-ink-muted" id="detail-description"></p>
      <p class="mt-3 text-2xl font-bold text-price" id="detail-price"></p>

      <div class="mt-6" id="detail-modifiers-section" style="display:none">
        <h3 class="mb-3 text-sm font-semibold text-ink">Personaliza tu pedido</h3>
        <div class="space-y-2" id="modifiers-list"></div>
      </div>

      <div class="mt-6 flex items-center gap-4">
        <button
          id="qty-minus"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle text-lg text-ink transition hover:bg-card-hover"
        >−</button>
        <span id="qty-display" class="w-8 text-center text-lg font-semibold text-ink">1</span>
        <button
          id="qty-plus"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle text-lg text-ink transition hover:bg-card-hover"
        >+</button>
      </div>
    </div>

    <!-- Footer / agregar -->
    <div class="border-t border-border-subtle p-4">
      <button
        id="add-to-cart"
        class="btn-primary w-full rounded-xl py-3 text-sm font-semibold shadow-lg"
        data-product-id=""
        disabled={!ordering}
      >
        {ordering ? 'Agregar al pedido' : 'Pedidos desactivados'}
      </button>
    </div>
  </div>
</div>