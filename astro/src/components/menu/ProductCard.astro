---
import type { Product } from '../../lib/types';
import { productImage } from '../../lib/brand';

export interface Props {
  product: Product;
  ordering: boolean;
  categoryName?: string | null;
}

const { product, ordering, categoryName } = Astro.props;
const hasModifiers = product.modifiers && product.modifiers.length > 0;
const hasBadges = product.is_vegetarian || product.is_spicy || product.is_featured;
const imageSrc = productImage(product.image_url, categoryName);
---

<div
  class="group flex h-full cursor-pointer overflow-hidden rounded-2xl border border-border-subtle bg-card transition hover:border-accent/40 hover:bg-card-hover lg:flex-col"
  data-product-id={product.id}
>
  <!-- Imagen (móvil: 104px a la izquierda; desktop: arriba) -->
  <div class="relative h-24 w-24 shrink-0 overflow-hidden lg:h-40 lg:w-full">
    <img
        src={imageSrc}
        alt={product.name}
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        loading="lazy"
      />

    {hasBadges && (
      <div class="absolute left-2 top-2 flex flex-wrap gap-1">
        {product.is_vegetarian && (
          <span class="flex items-center gap-1 rounded-full bg-veg/90 px-2 py-0.5 text-[10px] font-semibold text-cta-ink backdrop-blur">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Veg
          </span>
        )}
        {product.is_spicy && (
          <span class="rounded-full bg-accent-strong/90 px-2 py-0.5 text-[10px] font-semibold text-white backdrop-blur">
            Picante
          </span>
        )}
        {product.is_featured && (
          <span class="rounded-full bg-accent/90 px-2 py-0.5 text-[10px] font-semibold text-cta-ink backdrop-blur">
            Más pedido
          </span>
        )}
      </div>
    )}
  </div>

  <!-- Contenido -->
  <div class="flex min-w-0 flex-1 flex-col p-3 lg:flex-1 lg:flex-none">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-sm font-semibold text-ink">{product.name}</h3>
      <span class="shrink-0 text-sm font-bold text-price">${product.price.toLocaleString('es-CO')}</span>
    </div>
    {product.description && (
      <p class="mt-0.5 line-clamp-2 text-xs text-ink-muted">{product.description}</p>
    )}

    <div class="mt-auto flex items-center gap-2 pt-2">
      {hasModifiers && (
        <span class="rounded-full border border-border-subtle bg-accent-bg px-2 py-0.5 text-[11px] font-medium text-accent">
          Variantes
        </span>
      )}
      <button
        type="button"
        class="btn-primary ml-auto flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-base font-bold shadow-md transition"
        data-add-id={product.id}
        title={ordering ? 'Agregar al pedido' : 'Pedidos desactivados'}
        disabled={!ordering}
        aria-label={`Agregar ${product.name} al pedido`}
      >
        +
      </button>
    </div>
  </div>
</div>