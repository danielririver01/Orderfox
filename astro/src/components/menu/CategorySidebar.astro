---
import type { Category } from '../../lib/types';

export interface Props {
  categories: Category[];
  activeCategoryId?: number;
}

const { categories, activeCategoryId } = Astro.props;
---

<nav class="flex flex-col gap-1">
  {categories.map((cat) => (
    <a
      href={`#cat-${cat.id}`}
      class:list={[
        'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition',
        cat.id === activeCategoryId
          ? 'bg-brand-600/20 text-brand-300'
          : 'text-[#a1a1aa] hover:bg-white/5 hover:text-white',
      ]}
    >
      {cat.image_url && (
        <img src={cat.image_url} alt={cat.name} class="h-8 w-8 rounded-lg object-cover" />
      )}
      <span class="flex-1 truncate">{cat.name}</span>
      <span class="text-xs text-[#71717a]">{cat.product_count}</span>
    </a>
  ))}
</nav>

<script>
  document.querySelectorAll('nav a[href^="#cat-"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
