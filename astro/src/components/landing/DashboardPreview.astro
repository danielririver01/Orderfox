---
const stats = [
  { icon: 'payments', label: 'Ventas hoy', value: '$486.000' },
  { icon: 'receipt_long', label: 'Pedidos', value: '37' },
  { icon: 'trending_up', label: 'Ticket promedio', value: '$13.135' },
];

// Barras del chart: ventas de la semana (alto en px, relativo a 96px)
const bars = [
  { day: 'L', h: 34, active: false },
  { day: 'M', h: 52, active: false },
  { day: 'X', h: 44, active: false },
  { day: 'J', h: 68, active: false },
  { day: 'V', h: 88, active: true },
  { day: 'S', h: 96, active: true },
  { day: 'D', h: 72, active: true },
];

const sideItems = [
  { icon: 'dashboard', label: 'Inicio' },
  { icon: 'restaurant_menu', label: 'Menú', active: true },
  { icon: 'receipt_long', label: 'Pedidos' },
  { icon: 'monitoring', label: 'Analytics' },
  { icon: 'bubble_chart', label: 'Copilot' },
];
---

<section class="bg-card/40 py-20 lg:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 lg:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Tu negocio, <span class="text-accent">de un vistazo</span>
      </h2>
      <p class="mt-4 text-base text-ink-muted">
        Ventas, pedidos y tendencias en un dashboard pensado para ocuparse de la cocina, no de las cuentas.
      </p>
    </div>

    <!-- Mockup laptop (CSS puro) -->
    <div class="mx-auto mt-14 max-w-3xl">
      <div class="relative">
        <!-- Glow -->
        <div aria-hidden="true" class="absolute inset-x-10 bottom-0 h-24 rounded-full bg-accent/15 blur-3xl"></div>

        <!-- Pantalla -->
        <div class="relative overflow-hidden rounded-2xl border border-border-subtle bg-card shadow-2xl">
          <div class="flex h-[320px] sm:h-[380px]">
            <!-- Sidebar -->
            <aside class="hidden w-44 shrink-0 flex-col gap-1 border-r border-border-subtle bg-base/80 p-3 sm:flex">
              <p class="mb-3 flex items-center gap-2 px-2 font-display text-sm font-bold text-ink">
                <span class="flex h-6 w-6 items-center justify-center rounded-md bg-accent text-xs text-cta-ink">V</span>
                Velzia
              </p>
              {sideItems.map((item) => (
                <span
                  class:list={[
                    'flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium',
                    item.active ? 'bg-accent-bg text-accent' : 'text-ink-muted',
                  ]}
                >
                  <span class="material-symbols-outlined text-base" aria-hidden="true">{item.icon}</span>
                  {item.label}
                </span>
              ))}
              <span class="mt-auto rounded-lg border border-border-subtle p-2.5 text-[10px] leading-snug text-ink-faint">
                <span class="material-symbols-outlined mb-1 block text-sm text-accent" aria-hidden="true">auto_awesome</span>
                Copilot: "Tus ventas de viernes subieron 22% vs. la semana pasada."
              </span>
            </aside>

            <!-- Contenido -->
            <div class="flex min-w-0 flex-1 flex-col gap-3 p-4">
              <!-- Stats -->
              <div class="grid grid-cols-3 gap-3">
                {stats.map((stat) => (
                  <div class="rounded-xl border border-border-subtle bg-base/60 p-3">
                    <p class="flex items-center gap-1 text-[10px] font-medium text-ink-faint">
                      <span class="material-symbols-outlined text-sm" aria-hidden="true">{stat.icon}</span>
                      {stat.label}
                    </p>
                    <p class="mt-1 text-sm font-bold text-ink sm:text-lg">{stat.value}</p>
                  </div>
                ))}
              </div>

              <!-- Chart -->
              <div class="flex-1 rounded-xl border border-border-subtle bg-base/60 p-4">
                <div class="flex items-center justify-between">
                  <p class="text-xs font-semibold text-ink">Ventas de la semana</p>
                  <span class="rounded-full bg-veg/15 px-2 py-0.5 text-[10px] font-semibold text-veg">+18%</span>
                </div>
                <div class="mt-3 flex h-24 items-end gap-2 sm:h-28">
                  {bars.map((bar) => (
                    <div class="flex flex-1 flex-col items-center gap-1.5">
                      <div
                        class:list={['w-full rounded-t-md', bar.active ? 'bg-accent' : 'bg-border-subtle']}
                        style={`height:${bar.h}px`}
                      ></div>
                      <span class="text-[9px] text-ink-faint">{bar.day}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Base laptop -->
        <div class="relative mx-auto h-3 w-[86%] rounded-b-xl border-x border-b border-border-subtle bg-card"></div>
        <div class="relative mx-auto h-1 w-[70%] rounded-b-lg bg-card-hover"></div>
      </div>
    </div>
  </div>
</section>
