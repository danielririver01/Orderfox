---
import { LOGIN_URL, LEGAL_URL } from '../../lib/urls';

export interface Props {
  supportEmail?: string;
  supportPhone?: string;
}

const { supportEmail, supportPhone } = Astro.props;
const year = new Date().getFullYear();

const productLinks = [
  { href: '#features', label: 'Features' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#pricing', label: 'Planes' },
  { href: LOGIN_URL, label: 'Iniciar sesión' },
];

const legalLinks = [
  { href: LEGAL_URL, label: 'Términos y Condiciones' },
  { href: LEGAL_URL, label: 'Política de Privacidad' },
  { href: LEGAL_URL, label: 'Política de Datos' },
];
---

<footer class="border-t border-border-subtle bg-base">
  <div class="mx-auto w-full max-w-6xl px-4 py-12 lg:px-6">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2 font-display text-xl font-bold tracking-tight text-ink">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent font-sans text-lg text-cta-ink">V</span>
          Velzia
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-muted">
          Menú digital, pedidos organizados y analytics en tiempo real para tu restaurante.
        </p>
      </div>

      <nav aria-label="Producto">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Producto</h3>
        <ul class="mt-3 space-y-2">
          {productLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-muted transition hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Legal y contacto">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Legal</h3>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-muted transition hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 space-y-1 text-sm text-ink-muted">
          {supportEmail && (
            <a href={`mailto:${supportEmail}`} class="block transition hover:text-accent">{supportEmail}</a>
          )}
          {supportPhone && (
            <a href={`https://wa.me/${supportPhone.replace(/[^+\d]/g, '').replace('+', '')}`} class="block transition hover:text-accent">
              {supportPhone}
            </a>
          )}
        </div>
      </nav>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border-subtle pt-6 sm:flex-row">
      <p class="text-xs text-ink-faint">© {year} Velzia. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1.5 text-xs text-ink-muted">
        Hecho en Colombia
        <svg class="h-3.5 w-3.5" viewBox="0 0 36 24" aria-hidden="true">
          <rect width="36" height="12" y="0" fill="#FCD116" />
          <rect width="18" height="12" y="12" fill="#CE1126" />
          <rect width="18" height="12" y="12" x="18" fill="#003893" />
        </svg>
      </p>
    </div>
  </div>
</footer>
