---
import { LOGIN_URL, LEGAL_URL } from '../../lib/urls';

const WHATSAPP_NUMBER = '573123000887';
const WHATSAPP_LINK = `https://wa.me/${WHATSAPP_NUMBER}`;
const SUPPORT_EMAIL = 'velziaoficial@gmail.com';
const year = new Date().getFullYear();

const productLinks = [
  { href: '#features', label: 'Features' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#pricing', label: 'Planes' },
  { href: LOGIN_URL, label: 'Iniciar sesión' },
];

const legalLinks = [
  { href: LEGAL_URL, label: 'Términos y Condiciones' },
  { href: LEGAL_URL, label: 'Política de Privacidad' },
  { href: LEGAL_URL, label: 'Política de Datos' },
];
---

<footer class="border-t border-border-subtle bg-base">
  <div class="mx-auto w-full max-w-6xl px-4 py-12 lg:px-6">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2 font-display text-xl font-bold tracking-tight text-ink">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent font-sans text-lg text-cta-ink">V</span>
          Velzia
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-muted">
          Menú digital, pedidos organizados y analytics en tiempo real para tu restaurante.
        </p>
      </div>

      <nav aria-label="Producto">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Producto</h3>
        <ul class="mt-3 space-y-2">
          {productLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-muted transition hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Legal y contacto">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Legal</h3>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-muted transition hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 space-y-1 text-sm text-ink-muted">
          <a href={`mailto:${SUPPORT_EMAIL}`} class="block transition hover:text-accent">{SUPPORT_EMAIL}</a>
        </div>
      </nav>

      <nav aria-label="Contacto WhatsApp">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Contacto</h3>
        <p class="mt-3 text-sm text-ink-muted">¿Preguntas? Estamos en WhatsApp</p>
        <a
          href={WHATSAPP_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 rounded-full border border-[#25D366]/30 bg-[#25D366]/10 px-4 py-2 text-sm font-medium text-[#25D366] transition hover:bg-[#25D366]/20"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escríbenos
        </a>
      </nav>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border-subtle pt-6 sm:flex-row">
      <p class="text-xs text-ink-faint">© {year} Velzia. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1.5 text-xs text-ink-muted">
        Hecho en Colombia
        <svg class="h-3.5 w-3.5" viewBox="0 0 36 24" aria-hidden="true">
          <rect width="36" height="12" y="0" fill="#FCD116" />
          <rect width="18" height="12" y="12" fill="#CE1126" />
          <rect width="18" height="12" y="12" x="18" fill="#003893" />
        </svg>
      </p>
    </div>
  </div>
</footer>
