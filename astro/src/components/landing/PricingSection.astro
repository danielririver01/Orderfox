---
import { registerUrl } from '../../lib/urls';

const WHATSAPP_NUMBER = '573123000887';
const WHATSAPP_PLANS_LINK = `https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20los%20planes%20de%20Velzia`;

// Datos espejo de app/template/auth/plans.html (Flask). Precios en COP.
const plans = [
  {
    key: 'emprendedor',
    name: 'Emprendedor',
    price: '$30.000',
    period: '/mes',
    desc: 'Ideal para empezar a vender por delivery hoy mismo.',
    cta: 'Iniciar hoy',
    featured: false,
    accent: false,
    features: [
      { text: 'Menú Digital (Link compartible)', icon: 'check_circle' },
      { text: 'Pedidos ilimitados a WhatsApp', icon: 'check_circle' },
      { text: 'Menú Digital Inteligente', icon: 'qr_code_2' },
      { text: '1 empleado (cajero o mesero)', icon: 'group' },
      { text: '250 créditos IA incluidos', icon: 'auto_awesome', strong: true },
    ],
  },
  {
    key: 'crecimiento',
    name: 'Crecimiento',
    price: '$40.000',
    period: '/mes',
    desc: 'Para locales físicos que quieren tráfico desde las mesas.',
    cta: 'Elegir Crecimiento',
    featured: true,
    accent: true,
    features: [
      { text: 'Mesas digitales con QR inteligente', icon: 'qr_code_scanner', strong: true },
      { text: 'Catálogo: 100 productos activos', icon: 'format_list_bulleted' },
      { text: 'Hasta 5 empleados (cajeros y meseros)', icon: 'group' },
      { text: '800 créditos IA incluidos', icon: 'auto_awesome', strong: true },
    ],
  },
  {
    key: 'elite',
    name: 'Élite',
    price: '$50.000',
    period: '/mes',
    desc: 'Menús complejos y alta personalización operativa.',
    cta: 'Obtener Plan Élite',
    featured: false,
    accent: false,
    features: [
      { text: 'Personalización Avanzada de Menú', icon: 'add_task', strong: true },
      { text: 'Catálogo e Inventario Ilimitado', icon: 'all_out' },
      { text: 'Mesas digitales con QR inteligente', icon: 'qr_code_scanner', strong: true },
      { text: 'Equipo ilimitado', icon: 'group', strong: true },
      { text: '3000 créditos IA incluidos', icon: 'auto_awesome', strong: true },
    ],
  },
];

// Nota de contexto para el CTA del plan trial
const trialNote = '¿Prefieres probar antes? 60 días gratis con todo incluido.';
---

<section id="pricing" class="scroll-mt-24 py-20 lg:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 lg:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Precios claros, <span class="text-accent">sin letras pequeñas</span>
      </h2>
      <p class="mt-4 text-base text-ink-muted">
        Soluciones reales para cada tamaño de negocio. Escala a tu propio ritmo.
      </p>
    </div>

    <div class="mt-14 grid items-stretch gap-5 md:grid-cols-3">
      {plans.map((plan) => (
        <div
          class:list={[
            'relative flex flex-col rounded-2xl border p-6 transition',
            plan.featured
              ? 'border-accent/60 bg-card shadow-[0_0_40px_rgba(255,122,41,0.12)] md:-my-3 md:py-9'
              : 'border-border-subtle bg-card hover:bg-card-hover',
          ]}
        >
          {plan.featured && (
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3.5 py-1 text-xs font-bold text-cta-ink">
              ⭐ Más Popular
            </span>
          )}

          <h3 class="text-lg font-bold text-ink">{plan.name}</h3>
          <p class:list={['mt-1 text-sm', plan.featured ? 'text-ink-muted' : 'text-ink-faint']}>{plan.desc}</p>

          <p class="mt-5 flex items-baseline gap-1">
            <span
              class:list={[
                'font-display text-4xl font-bold tracking-tight',
                plan.featured ? 'bg-gradient-to-r from-accent to-amber-400 bg-clip-text text-transparent' : 'text-ink',
              ]}
            >
              {plan.price}
            </span>
            <span class="text-sm font-medium text-ink-faint">{plan.period}</span>
          </p>

          <div class="my-5 border-t border-border-subtle"></div>

          <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-faint">Lo que obtienes:</p>
          <ul class="mt-3 flex flex-1 flex-col gap-2.5">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm">
                <span
                  class:list={[
                    'material-symbols-outlined mt-0.5 text-base',
                    feature.strong ? 'text-accent' : 'text-veg',
                  ]}
                  aria-hidden="true"
                >
                  {feature.icon}
                </span>
                <span class:list={[feature.strong ? 'font-semibold text-ink' : 'text-ink-muted']}>{feature.text}</span>
              </li>
            ))}
          </ul>

          <a
            href={registerUrl(plan.key)}
            class:list={[
              'mt-6 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition',
              plan.featured
                ? 'bg-accent text-cta-ink hover:scale-[1.02] hover:bg-accent-hover'
                : 'border border-border-subtle bg-card text-ink hover:bg-card-hover',
            ]}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <p class="text-sm text-ink-muted">
        {trialNote}
        <a href={registerUrl('trial')} class="font-semibold text-accent transition hover:underline">Empieza tu prueba gratis →</a>
      </p>
      <p class="mt-2 text-xs italic text-ink-faint">
        * Precios en Pesos Colombianos (COP). Activación inmediata tras confirmación.
      </p>
    </div>

    <div class="mt-12 rounded-2xl border border-border-subtle bg-card p-8 text-center">
      <p class="text-lg font-semibold text-ink">¿No sabes cuál plan elegir?</p>
      <p class="mt-2 text-sm text-ink-muted">Cuéntanos tu caso y te ayudamos a elegir el plan ideal.</p>
      <a
        href={WHATSAPP_PLANS_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-[#25D366]/30 bg-[#25D366]/10 px-6 py-3 text-sm font-medium text-[#25D366] transition hover:bg-[#25D366]/20"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Hablar por WhatsApp
      </a>
    </div>
  </div>
</section>
