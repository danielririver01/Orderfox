---
import { LOGIN_URL, registerUrl } from '../../lib/urls';

export interface Props {
  loginUrl?: string;
}

const { loginUrl = LOGIN_URL } = Astro.props;

const pills = ['Entradas', 'Platos fuertes', 'Bebidas'];
const products = [
  {
    name: 'Churrasco 300g',
    desc: 'Con papas criollas y chimichurri',
    price: '$38.900',
    grad: 'linear-gradient(135deg,#B84A12,#FF7A29)',
  },
  {
    name: 'Limonada de coco',
    desc: '500 ml · Bien fría',
    price: '$12.000',
    grad: 'linear-gradient(135deg,#3A2214,#C9541A)',
  },
];
---

<section class="relative overflow-hidden pb-20 pt-28 lg:pb-28 lg:pt-40">
  <!-- Orbs decorativos (CSS puro) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 left-1/2 h-[420px] w-[420px] -translate-x-[70%] rounded-full bg-accent/15 blur-[120px]"></div>
    <div class="absolute right-[-120px] top-24 h-[360px] w-[360px] rounded-full bg-accent-strong/20 blur-[110px]"></div>
  </div>

  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-4 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8 lg:px-6">
    <!-- Copy -->
    <div class="text-center lg:text-left">
      <h1 class="font-display text-4xl font-bold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl">
        Deja de perder pedidos
        <span class="text-accent">por WhatsApp</span>
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg lg:mx-0">
        Velzia digitaliza tu menú, organiza tus pedidos y te muestra exactamente dónde está tu plata.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a
          href={registerUrl('trial')}
          class="inline-flex w-full items-center justify-center rounded-full bg-accent px-8 py-3.5 text-base font-semibold text-cta-ink transition hover:scale-[1.03] hover:bg-accent-hover sm:w-auto"
        >
          Empieza gratis
        </a>
        <a
          href="#pricing"
          class="inline-flex w-full items-center justify-center rounded-full border border-border-subtle bg-card px-8 py-3.5 text-base font-semibold text-ink transition hover:bg-card-hover sm:w-auto"
        >
          Ver planes
        </a>
      </div>

      <p class="mt-5 text-sm text-ink-faint">Sin tarjeta. 60 días de prueba con todo incluido.</p>
    </div>

    <!-- Mockup iPhone (CSS puro) -->
    <div class="mx-auto w-full max-w-[300px]">
      <div class="relative">
        <div aria-hidden="true" class="absolute inset-6 rounded-[3rem] bg-accent/25 blur-3xl"></div>
        <div class="relative rounded-[2.75rem] border border-border-subtle bg-card p-2.5 shadow-2xl">
          <div class="relative overflow-hidden rounded-[2.25rem] bg-base">
            <!-- Notch -->
            <div aria-hidden="true" class="absolute left-1/2 top-2 z-10 h-5 w-24 -translate-x-1/2 rounded-full bg-black"></div>

            <div class="px-3 pb-4 pt-9">
              <!-- Header menú -->
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-display text-sm font-semibold text-ink">La Parrilla de Ana</p>
                  <p class="mt-0.5 flex items-center gap-1 text-[10px] font-medium text-veg">
                    <span class="h-1.5 w-1.5 rounded-full bg-veg"></span> Abierto · ≈ 25 min
                  </p>
                </div>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-card text-xs" aria-hidden="true">🍔</span>
              </div>

              <!-- Pills de categorías -->
              <div class="mt-3 flex gap-1.5 overflow-hidden">
                {pills.map((pill, i) => (
                  <span
                    class:list={[
                      'shrink-0 rounded-full px-2.5 py-1 text-[9px] font-medium',
                      i === 1 ? 'bg-accent text-cta-ink' : 'border border-border-subtle bg-card text-ink-muted',
                    ]}
                  >
                    {pill}
                  </span>
                ))}
              </div>

              <!-- Productos -->
              <div class="mt-3 space-y-2">
                {products.map((p) => (
                  <div class="flex items-center gap-2.5 rounded-xl border border-border-subtle bg-card p-2">
                    <div class="h-11 w-11 shrink-0 rounded-lg" style={`background:${p.grad}`}></div>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-[11px] font-semibold text-ink">{p.name}</p>
                      <p class="truncate text-[9px] text-ink-faint">{p.desc}</p>
                    </div>
                    <div class="text-right">
                      <p class="text-[11px] font-bold text-accent">{p.price}</p>
                      <span class="mt-0.5 inline-flex h-4 w-4 items-center justify-center rounded-full bg-accent text-[10px] font-bold text-cta-ink">+</span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Botón pedido -->
              <div class="mt-3 rounded-full bg-accent py-2 text-center text-[11px] font-semibold text-cta-ink">
                Ver pedido · 2 items · $50.900
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
