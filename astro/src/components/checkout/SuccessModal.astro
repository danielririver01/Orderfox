---
export interface Props {
  whatsappPhone: string;
}
const { whatsappPhone } = Astro.props;
---

<div id="success-overlay" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm"></div>

<div
  id="success-modal"
  class="fixed inset-0 z-50 mx-auto my-auto hidden h-fit w-full max-w-md translate-y-8 transform overflow-hidden rounded-2xl bg-[#0f0f0f] shadow-2xl transition-all duration-300"
  data-whatsapp={whatsappPhone}
>
  <div class="bg-gradient-to-br from-green-500 to-emerald-600 px-6 py-10 text-center text-white">
    <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-white/20">
      <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h2 class="text-xl font-bold">Pedido confirmado</h2>
    <p class="mt-1 text-sm text-white/80">Tu pedido ha sido recibido</p>
  </div>
  <div class="p-6 text-center">
    <p class="text-sm text-[#a1a1aa]">Número de pedido</p>
    <p id="success-order-number" class="mt-1 text-2xl font-bold text-[#f5f5f7]">ORD-000</p>
    <p id="success-total" class="mt-2 text-lg font-bold text-brand-400"></p>
    <div class="mt-6 flex flex-col gap-3">
      <button id="whatsapp-confirm"
        class="w-full rounded-xl bg-green-500 py-3 text-sm font-semibold text-white transition hover:bg-green-600"
      >
        Confirmar por WhatsApp
      </button>
      <button id="success-close"
        class="w-full rounded-xl border border-white/10 py-3 text-sm font-semibold text-[#a1a1aa] transition hover:bg-white/5"
      >
        Seguir viendo el menú
      </button>
    </div>
  </div>
</div>

<script>
  const successModal = document.getElementById('success-modal');
  const wpPhone = successModal?.getAttribute('data-whatsapp') || '';
  let lastResult: any = null;

  document.addEventListener('order-success', ((e: CustomEvent) => {
    lastResult = e.detail;
    document.getElementById('success-order-number')!.textContent = e.detail.order_number;
    document.getElementById('success-total')!.textContent = '$' + e.detail.total.toLocaleString('es-CO');
    document.getElementById('success-modal')?.classList.remove('hidden', 'translate-y-8');
    document.getElementById('success-overlay')?.classList.remove('hidden');
  }) as EventListener);

  document.getElementById('whatsapp-confirm')?.addEventListener('click', () => {
    if (!lastResult) return;
    const items = lastResult.items?.map((i: any) => `• ${i.name} x${i.qty}`).join('\n') || '';
    const text = `¡Hola! Quiero confirmar mi pedido:\n\n*N°:* ${lastResult.order_number}\n*Total:* $${lastResult.total.toLocaleString('es-CO')}\n\n${items}`;
    window.open(`https://wa.me/${wpPhone}?text=${encodeURIComponent(text)}`, '_blank');
  });

  document.getElementById('success-close')?.addEventListener('click', () => {
    document.getElementById('success-modal')?.classList.add('hidden', 'translate-y-8');
    document.getElementById('success-overlay')?.classList.add('hidden');
    location.reload();
  });
</script>
