---
export interface Props {
  restaurantSlug: string;
  restaurantId: number;
  tableId?: number | string | null;
}

const { restaurantSlug, restaurantId, tableId } = Astro.props;
const isTableOrder = tableId !== null && tableId !== undefined && tableId !== '';
---

<div id="checkout-overlay" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm"></div>

<div
  id="checkout-modal"
  class="fixed inset-0 z-50 mx-auto my-auto hidden h-fit max-h-[90vh] w-full max-w-md translate-y-8 transform overflow-y-auto rounded-2xl border border-border-subtle bg-card p-6 shadow-2xl transition-all duration-300"
  data-restaurant-id={restaurantId}
  data-restaurant-slug={restaurantSlug}
  data-table-id={tableId ?? ''}
  data-api-base="https://velzia.shop"
>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="font-display text-lg font-semibold text-ink">Confirmar pedido</h2>
    <button id="checkout-close" class="rounded-full p-2 text-ink-muted transition hover:bg-card-hover" aria-label="Cerrar">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <form id="checkout-form" class="space-y-4">
    <input type="hidden" name="restaurant_id" value={restaurantId} />
    {!tableId ? (
      <>
    <div>
      <label class="mb-1 block text-sm font-medium text-ink-muted">Tu nombre</label>
      <input type="text" name="customer_name" required
        class="w-full rounded-xl border border-border-subtle bg-card-hover px-4 py-2.5 text-sm text-ink placeholder-ink-faint outline-none transition focus:border-accent/60 focus:ring-2 focus:ring-accent/15"
      />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-ink-muted">WhatsApp / Teléfono</label>
      <input type="tel" name="customer_phone" required
        class="w-full rounded-xl border border-border-subtle bg-card-hover px-4 py-2.5 text-sm text-ink placeholder-ink-faint outline-none transition focus:border-accent/60 focus:ring-2 focus:ring-accent/15"
      />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-ink-muted">Dirección de entrega</label>
      <input type="text" name="address"
        class="w-full rounded-xl border border-border-subtle bg-card-hover px-4 py-2.5 text-sm text-ink placeholder-ink-faint outline-none transition focus:border-accent/60 focus:ring-2 focus:ring-accent/15"
      />
    </div>
      </>
    ) : (
      <p class="text-center text-sm text-ink-muted">Pedido de mesa — solo confirma para enviar</p>
    )}
    <input type="text" name="user_secondary_email" class="absolute -left-[9999px]" tabindex="-1" autocomplete="off" />
    <button type="submit"
      class="btn-primary w-full rounded-xl py-3 text-sm font-semibold shadow-lg disabled:opacity-50"
    >
      Confirmar y pedir
    </button>
  </form>
  <div id="checkout-error" class="mt-3 hidden text-center text-sm text-red-400"></div>
</div>

<script>
  const checkoutModal = document.getElementById('checkout-modal');
  const slugs = checkoutModal?.getAttribute('data-restaurant-slug') || '';
  const rId = parseInt(checkoutModal?.getAttribute('data-restaurant-id') || '0', 10);
  const tIdRaw = checkoutModal?.getAttribute('data-table-id');
  const tableId = tIdRaw ? (isNaN(parseInt(tIdRaw, 10)) ? tIdRaw : parseInt(tIdRaw, 10)) : null;
  const apiBase = checkoutModal?.getAttribute('data-api-base') || 'https://velzia.shop';

  document.addEventListener('open-checkout', () => {
    document.getElementById('checkout-modal')?.classList.remove('hidden', 'translate-y-8');
    document.getElementById('checkout-overlay')?.classList.remove('hidden');
    resetSubmitState();
  });

  // ── Idempotencia (v1.5) ─────────────────────────────────────
  // Clave por carrito: se genera la primera vez que se abre el checkout y
  // persiste mientras el carrito no cambie. Así, un reintento tras error de
  // red reenvía la MISMA clave → el servidor devuelve el pedido original
  // en vez de crear otro. Cambiar el carrito = pedido nuevo = clave nueva.
  const IDEMPOTENCY_STORAGE_KEY = `velziaIdemKey_${rId}`;
  const CART_STORAGE_KEY = `velziaCart_${rId}`;
  function getCurrentIdempotencyKey(): string {
    let key = sessionStorage.getItem(IDEMPOTENCY_STORAGE_KEY) || '';
    if (!key) {
      key = crypto.randomUUID();
      try { sessionStorage.setItem(IDEMPOTENCY_STORAGE_KEY, key); } catch { /* ignore */ }
    }
    return key;
  }
  function invalidateIdempotencyKey(): void {
    try { sessionStorage.removeItem(IDEMPOTENCY_STORAGE_KEY); } catch { /* ignore */ }
  }
  document.addEventListener('cart-updated', () => {
    // El cliente modificó el carrito: lo que envíe ya no es el mismo pedido.
    invalidateIdempotencyKey();
  });
  document.addEventListener('order-success', () => {
    // Pedido confirmado: la clave se consumió.
    invalidateIdempotencyKey();
  });

  document.getElementById('checkout-close')?.addEventListener('click', closeCheckout);
  document.getElementById('checkout-overlay')?.addEventListener('click', closeCheckout);

  function closeCheckout(): void {
    document.getElementById('checkout-modal')?.classList.add('hidden', 'translate-y-8');
    document.getElementById('checkout-overlay')?.classList.add('hidden');
  }

  // ── Anti doble-envío ─────────────────────────────────────────────
  // El handler es async: sin lock, un doble tap dispara dos fetch y crea
  // pedidos duplicados. El flag se marca síncronamente antes del primer
  // await, así el segundo submit siempre lo ve.
  function setSubmitState(form: HTMLFormElement, busy: boolean): void {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (busy) {
      form.dataset.submitting = '1';
      if (btn) {
        if (!btn.dataset.label) btn.dataset.label = btn.textContent || '';
        btn.disabled = true;
        btn.textContent = 'Enviando...';
      }
    } else {
      delete form.dataset.submitting;
      if (btn) {
        btn.disabled = false;
        btn.textContent = btn.dataset.label || 'Confirmar y pedir';
      }
    }
  }

  function resetSubmitState(): void {
    const form = document.getElementById('checkout-form') as HTMLFormElement | null;
    if (form) setSubmitState(form, false);
  }

  document.getElementById('checkout-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const errorEl = document.getElementById('checkout-error');

    // Doble tap / re-envío mientras hay un fetch en vuelo → ignorar.
    if (form.dataset.submitting === '1') return;

    const data = new FormData(form);

    const cartRaw = localStorage.getItem(`velziaCart_${rId}`);
    if (!cartRaw) {
      if (errorEl) { errorEl.textContent = 'El carrito está vacío'; errorEl.classList.remove('hidden'); }
      return;
    }

    const parsed = JSON.parse(cartRaw);
    const cart: Record<number, { quantity: number; extras: { id: number }[] }> = {};
    for (const item of parsed.items || []) {
      cart[item.product.id] = {
        quantity: item.quantity,
        extras: (item.selectedModifiers || []).map((m: any) => ({ id: m.id })),
      };
    }

    // En pedidos desde mesa los campos de contacto son opcionales; usamos defaults.
    const isTableOrder = tableId !== null && tableId !== undefined && tableId !== '';
    const body = {
      cart,
      total: parsed.items?.reduce((s: number, item: any) => {
        const extras = item.selectedModifiers?.reduce((m: number, mod: any) => m + mod.extra_price, 0) || 0;
        return s + (item.product.price + extras) * item.quantity;
      }, 0) || 0,
      restaurant_id: rId,
      table_id: tableId,
      customer_name: isTableOrder
        ? ((data.get('customer_name') as string) || 'Cliente Mesa')
        : (data.get('customer_name') as string),
      customer_phone: isTableOrder
        ? ((data.get('customer_phone') as string) || '')
        : (data.get('customer_phone') as string),
      address: isTableOrder
        ? ((data.get('address') as string) || '')
        : (data.get('address') as string),
      user_secondary_email: data.get('user_secondary_email') as string,
      // Idempotencia v1.5: en el body, no en header custom (evita preflight
      // CORS entre menu.velzia.shop y la API en velzia.shop).
      idempotency_key: getCurrentIdempotencyKey(),
    };

    // Validación y armado del body completos: recién ahora bloqueamos.
    // (Si falla antes —carrito vacío, JSON corrupto— el botón queda libre.)
    setSubmitState(form, true);

    try {
      const res = await fetch(`${apiBase}/menu/api/order`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (!res.ok) {
        const err = await res.json();
        setSubmitState(form, false); // permitir reintento
        if (errorEl) { errorEl.textContent = err.error || 'Error al procesar el pedido'; errorEl.classList.remove('hidden'); }
        return;
      }

      const result = await res.json();
      setSubmitState(form, false);
      localStorage.removeItem(CART_STORAGE_KEY);
      closeCheckout();
      document.dispatchEvent(new CustomEvent('order-success', { detail: result }));
    } catch {
      setSubmitState(form, false); // permitir reintento
      if (errorEl) { errorEl.textContent = 'Error de conexión. Intenta de nuevo.'; errorEl.classList.remove('hidden'); }
    }
  });
</script>