---
export interface Props {
  restaurantSlug: string;
  restaurantId: number;
  tableId?: number | string | null;
}

const { restaurantSlug, restaurantId, tableId } = Astro.props;
---

<div id="checkout-overlay" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm"></div>

<div
  id="checkout-modal"
  class="fixed inset-0 z-50 mx-auto my-auto hidden h-fit max-h-[90vh] w-full max-w-md translate-y-8 transform overflow-y-auto rounded-2xl border border-border-subtle bg-card p-6 shadow-2xl transition-all duration-300"
  data-restaurant-id={restaurantId}
  data-restaurant-slug={restaurantSlug}
  data-table-id={tableId ?? ''}
>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="font-display text-lg font-semibold text-ink">Confirmar pedido</h2>
    <button id="checkout-close" class="rounded-full p-2 text-ink-muted transition hover:bg-card-hover" aria-label="Cerrar">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <form id="checkout-form" class="space-y-4">
    <input type="hidden" name="restaurant_id" value={restaurantId} />
    <div>
      <label class="mb-1 block text-sm font-medium text-ink-muted">Tu nombre</label>
      <input type="text" name="customer_name" required
        class="w-full rounded-xl border border-border-subtle bg-card-hover px-4 py-2.5 text-sm text-ink placeholder-ink-faint outline-none transition focus:border-accent/60 focus:ring-2 focus:ring-accent/15"
      />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-ink-muted">WhatsApp / Teléfono</label>
      <input type="tel" name="customer_phone" required
        class="w-full rounded-xl border border-border-subtle bg-card-hover px-4 py-2.5 text-sm text-ink placeholder-ink-faint outline-none transition focus:border-accent/60 focus:ring-2 focus:ring-accent/15"
      />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-ink-muted">Dirección de entrega</label>
      <input type="text" name="address"
        class="w-full rounded-xl border border-border-subtle bg-card-hover px-4 py-2.5 text-sm text-ink placeholder-ink-faint outline-none transition focus:border-accent/60 focus:ring-2 focus:ring-accent/15"
      />
    </div>
    <input type="text" name="user_secondary_email" class="absolute -left-[9999px]" tabindex="-1" autocomplete="off" />
    <button type="submit"
      class="btn-primary w-full rounded-xl py-3 text-sm font-semibold shadow-lg disabled:opacity-50"
    >
      Confirmar y pedir
    </button>
  </form>
  <div id="checkout-error" class="mt-3 hidden text-center text-sm text-red-400"></div>
</div>

<script>
  const checkoutModal = document.getElementById('checkout-modal');
  const slugs = checkoutModal?.getAttribute('data-restaurant-slug') || '';
  const rId = parseInt(checkoutModal?.getAttribute('data-restaurant-id') || '0', 10);
  const tIdRaw = checkoutModal?.getAttribute('data-table-id');
  const tableId = tIdRaw ? (isNaN(parseInt(tIdRaw, 10)) ? tIdRaw : parseInt(tIdRaw, 10)) : null;

  document.addEventListener('open-checkout', () => {
    document.getElementById('checkout-modal')?.classList.remove('hidden', 'translate-y-8');
    document.getElementById('checkout-overlay')?.classList.remove('hidden');
  });

  document.getElementById('checkout-close')?.addEventListener('click', closeCheckout);
  document.getElementById('checkout-overlay')?.addEventListener('click', closeCheckout);

  function closeCheckout(): void {
    document.getElementById('checkout-modal')?.classList.add('hidden', 'translate-y-8');
    document.getElementById('checkout-overlay')?.classList.add('hidden');
  }

  document.getElementById('checkout-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const errorEl = document.getElementById('checkout-error');

    const cartRaw = localStorage.getItem(`velziaCart_${rId}`);
    if (!cartRaw) {
      if (errorEl) { errorEl.textContent = 'El carrito está vacío'; errorEl.classList.remove('hidden'); }
      return;
    }

    const parsed = JSON.parse(cartRaw);
    const cart: Record<number, { quantity: number; extras: { id: number }[] }> = {};
    for (const item of parsed.items || []) {
      cart[item.product.id] = {
        quantity: item.quantity,
        extras: (item.selectedModifiers || []).map((m: any) => ({ id: m.id })),
      };
    }

    const body = {
      cart,
      total: parsed.items?.reduce((s: number, item: any) => {
        const extras = item.selectedModifiers?.reduce((m: number, mod: any) => m + mod.extra_price, 0) || 0;
        return s + (item.product.price + extras) * item.quantity;
      }, 0) || 0,
      restaurant_id: rId,
      table_id: tableId,
      customer_name: data.get('customer_name') as string,
      customer_phone: data.get('customer_phone') as string,
      address: data.get('address') as string,
      user_secondary_email: data.get('user_secondary_email') as string,
    };

    try {
      const res = await fetch(`/menu/api/order`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (!res.ok) {
        const err = await res.json();
        if (errorEl) { errorEl.textContent = err.error || 'Error al procesar el pedido'; errorEl.classList.remove('hidden'); }
        return;
      }

      const result = await res.json();
      localStorage.removeItem(`velziaCart_${rId}`);
      closeCheckout();
      document.dispatchEvent(new CustomEvent('order-success', { detail: result }));
    } catch {
      if (errorEl) { errorEl.textContent = 'Error de conexión. Intenta de nuevo.'; errorEl.classList.remove('hidden'); }
    }
  });
</script>