---
export interface Props {
  restaurantId: number;
  whatsappPhone: string;
}

const { restaurantId, whatsappPhone } = Astro.props;
---

<div id="cart-overlay" class="fixed inset-0 z-30 hidden bg-black/60 backdrop-blur-sm"></div>

<div
  id="cart-sidebar"
  class="fixed right-0 top-0 z-40 flex h-full w-full max-w-sm translate-x-full transform flex-col bg-card shadow-2xl transition-transform duration-300"
  data-restaurant-id={restaurantId}
  data-whatsapp={whatsappPhone}
>
  <div class="flex items-center justify-between border-b border-border-subtle p-4">
    <h2 class="font-display text-lg font-semibold text-ink">Tu pedido</h2>
    <button id="cart-close" class="rounded-full p-2 text-ink-muted transition hover:bg-card-hover" aria-label="Cerrar carrito">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div id="cart-items" class="flex-1 overflow-y-auto p-4">
    <p class="py-10 text-center text-sm text-ink-faint">Tu pedido está vacío</p>
  </div>
  <div id="cart-footer" class="hidden border-t border-border-subtle p-4">
    <div class="mb-3 flex items-center justify-between text-sm">
      <span class="text-ink-muted">Total</span>
      <span id="cart-total" class="text-lg font-bold text-price">$0</span>
    </div>
    <button
      id="clear-cart-btn"
      class="mb-2 w-full rounded-xl border border-border-subtle py-2 text-xs font-medium text-ink-muted transition hover:bg-card-hover"
    >
      Vaciar pedido
    </button>
    <button
      id="checkout-btn"
      class="btn-primary w-full rounded-xl py-3 text-sm font-semibold shadow-lg"
    >
      Comprar ahora
    </button>
  </div>
</div>

<script>
  const sidebar = document.getElementById('cart-sidebar');
  const restaurantIdNum = parseInt(sidebar?.getAttribute('data-restaurant-id') || '0', 10);
  const whatsapp = sidebar?.getAttribute('data-whatsapp') || '';

  function loadCartItems(): any[] {
    const raw = localStorage.getItem(`velziaCart_${restaurantIdNum}`);
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw);
      return parsed.items || [];
    } catch {
      return [];
    }
  }

  function saveCartItems(items: any[]): void {
    localStorage.setItem(`velziaCart_${restaurantIdNum}`, JSON.stringify({ timestamp: Date.now(), items }));
    document.dispatchEvent(new CustomEvent('cart-updated'));
  }

  let detailWasOpen = false;

  function openCart(): void {
    const detail = document.getElementById('product-detail');
    detailWasOpen = !!(detail && !detail.classList.contains('translate-x-full'));
    document.getElementById('cart-sidebar')?.classList.remove('translate-x-full');
    document.getElementById('cart-overlay')?.classList.remove('hidden');
    if (detail) detail.classList.add('translate-x-full');
    renderCart();
  }

  function closeCart(): void {
    document.getElementById('cart-sidebar')?.classList.add('translate-x-full');
    document.getElementById('cart-overlay')?.classList.add('hidden');
    const detail = document.getElementById('product-detail');
    if (detailWasOpen && detail) {
      detail.classList.remove('translate-x-full');
    } else {
      document.body.style.overflow = '';
    }
    detailWasOpen = false;
  }

  function renderCart(): void {
    const container = document.getElementById('cart-items');
    const footer = document.getElementById('cart-footer');
    const totalEl = document.getElementById('cart-total');
    if (!container) return;

    const items = loadCartItems();
    if (items.length === 0) {
      container.innerHTML = '<p class="py-10 text-center text-sm text-ink-faint">Tu pedido está vacío</p>';
      footer?.classList.add('hidden');
      return;
    }

    container.innerHTML = items.map((item: any, i: number) => {
      const extras = (item.selectedModifiers || []).reduce((s: number, m: any) => s + (m.extra_price || 0), 0);
      const unit = item.product.price + extras;
      return `
        <div class="mb-3 rounded-xl border border-border-subtle bg-card-hover p-3" data-index="${i}">
          <div class="flex items-start justify-between">
            <div class="flex-1 pr-2">
              <h4 class="text-sm font-semibold text-ink">${item.product.name}</h4>
              ${item.selectedModifiers?.length ? `<p class="mt-1 text-xs text-ink-muted">${item.selectedModifiers.map((m: any) => m.name).join(', ')}</p>` : ''}
              <p class="mt-1 text-xs font-bold text-price">$${unit.toLocaleString('es-CO')} c/u</p>
            </div>
            <button class="remove-item flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-ink-faint transition hover:bg-red-500/20 hover:text-red-400" data-index="${i}" title="Eliminar">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
            </button>
          </div>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-3 rounded-full border border-border-subtle px-2 py-1">
              <button class="qty-minus flex h-6 w-6 items-center justify-center text-ink transition hover:text-accent" data-index="${i}">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <span class="min-w-5 text-center text-sm font-semibold text-ink">${item.quantity}</span>
              <button class="qty-plus flex h-6 w-6 items-center justify-center text-ink transition hover:text-accent" data-index="${i}">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
            <span class="text-sm font-bold text-price">$${(unit * item.quantity).toLocaleString('es-CO')}</span>
          </div>
        </div>
      `;
    }).join('');

    const total = items.reduce((s: number, item: any) => {
      const extras = (item.selectedModifiers || []).reduce((m: number, mod: any) => m + (mod.extra_price || 0), 0) || 0;
      return s + (item.product.price + extras) * item.quantity;
    }, 0);

    if (totalEl) totalEl.textContent = '$' + total.toLocaleString('es-CO');
    footer?.classList.remove('hidden');
  }

  document.getElementById('cart-toggle-btn')?.addEventListener('click', openCart);
  document.getElementById('sidebar-cart-btn')?.addEventListener('click', openCart);
  document.addEventListener('open-cart', openCart);
  document.getElementById('cart-close')?.addEventListener('click', closeCart);
  document.getElementById('cart-overlay')?.addEventListener('click', closeCart);

  document.getElementById('clear-cart-btn')?.addEventListener('click', () => {
    localStorage.removeItem(`velziaCart_${restaurantIdNum}`);
    document.dispatchEvent(new CustomEvent('cart-updated'));
    renderCart();
    closeCart();
  });

  document.getElementById('cart-items')?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const minusBtn = target.closest('.qty-minus') as HTMLElement;
    const plusBtn = target.closest('.qty-plus') as HTMLElement;
    const removeBtn = target.closest('.remove-item') as HTMLElement;

    if (minusBtn) {
      const idx = parseInt(minusBtn.getAttribute('data-index') || '0', 10);
      const items = loadCartItems();
      if (items[idx]) {
        items[idx].quantity -= 1;
        if (items[idx].quantity <= 0) items.splice(idx, 1);
        saveCartItems(items);
        renderCart();
        if (items.length === 0) closeCart();
      }
    } else if (plusBtn) {
      const idx = parseInt(plusBtn.getAttribute('data-index') || '0', 10);
      const items = loadCartItems();
      if (items[idx] && items[idx].quantity < 99) {
        items[idx].quantity += 1;
        saveCartItems(items);
        renderCart();
      }
    } else if (removeBtn) {
      const idx = parseInt(removeBtn.getAttribute('data-index') || '0', 10);
      const items = loadCartItems();
      items.splice(idx, 1);
      saveCartItems(items);
      renderCart();
      if (items.length === 0) closeCart();
    }
  });

  document.getElementById('checkout-btn')?.addEventListener('click', () => {
    closeCart();
    document.dispatchEvent(new CustomEvent('open-checkout'));
  });
</script>