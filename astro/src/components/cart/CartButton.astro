---
export interface Props {
  restaurantId: number;
}

const { restaurantId } = Astro.props;
---

<button
  id="cart-toggle-btn"
  class="fixed bottom-6 left-6 z-30 hidden items-center gap-2 rounded-full bg-brand-500 px-5 py-3 text-sm font-semibold text-white shadow-xl transition hover:bg-brand-600 lg:left-6 lg:ml-72"
  data-restaurant-id={restaurantId}
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
  </svg>
  <span>Pedido</span>
  <span id="cart-count" class="flex h-5 min-w-5 items-center justify-center rounded-full bg-white/20 px-1.5 text-xs">0</span>
</button>

<script>
  const restaurantId = document.querySelector('#cart-toggle-btn')?.getAttribute('data-restaurant-id');
  if (restaurantId) {
    const updateCount = (pulse?: boolean) => {
      const raw = localStorage.getItem(`velziaCart_${restaurantId}`);
      if (!raw) return;
      try {
        const parsed = JSON.parse(raw);
        const count = parsed.items?.reduce?.((s: number, i: any) => s + (i.quantity || 0), 0) || 0;
        const badge = document.getElementById('cart-count');
        const btn = document.getElementById('cart-toggle-btn');
        if (badge) badge.textContent = String(count);
        if (btn) {
          btn.classList.toggle('hidden', count === 0);
          if (pulse && count > 0) {
            btn.classList.remove('cart-pulse');
            void (btn as HTMLElement).offsetWidth;
            btn.classList.add('cart-pulse');
          }
        }
      } catch {}
    };
    updateCount();
    window.addEventListener('storage', () => updateCount());
    document.addEventListener('cart-updated', () => updateCount(true));
  }
</script>
