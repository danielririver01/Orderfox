---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import ProblemSection from '../components/landing/ProblemSection.astro';
import FeaturesGrid from '../components/landing/FeaturesGrid.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import DashboardPreview from '../components/landing/DashboardPreview.astro';
import PricingSection from '../components/landing/PricingSection.astro';
import FAQSection from '../components/landing/FAQSection.astro';
import FloatingWhatsApp from '../components/landing/FloatingWhatsApp.astro';

// Solo en el entorno de prueba: si se define PUBLIC_DEMO_SLUG, la raíz abre
// ese menú en lugar de la landing, para poder verlo sin saber la ruta.
// En producción la variable no existe, así que la landing se ve igual.
const DEMO_SLUG = import.meta.env.PUBLIC_DEMO_SLUG;
if (DEMO_SLUG) {
  // Ruta relativa a propósito: Astro.redirect() arma una URL absoluta con la
  // dirección interna (127.0.0.1), que el navegador de afuera no alcanza.
  return new Response(null, { status: 302, headers: { Location: `/${DEMO_SLUG}` } });
}

const TITLE = 'Velzia Colombia — Menú digital e inteligencia para restaurantes';
const DESCRIPTION =
  'Velzia es el software gastronómico colombiano para restaurantes. Menú digital QR, pedidos por WhatsApp, analytics e IA. Prueba gratis 60 días, sin tarjeta de crédito.';
const SITE_URL = 'https://velzia.shop';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Velzia',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: DESCRIPTION,
  url: SITE_URL,
  areaServed: 'Colombia',
  brand: 'Velzia Colombia',
  offers: [
    { '@type': 'Offer', name: 'Emprendedor', price: '30000', priceCurrency: 'COP' },
    { '@type': 'Offer', name: 'Crecimiento', price: '40000', priceCurrency: 'COP' },
    { '@type': 'Offer', name: 'Élite', price: '50000', priceCurrency: 'COP' },
  ],
});
---

<LandingLayout title={TITLE} description={DESCRIPTION}>
  <slot name="head">
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Velzia" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />

    <link rel="canonical" href={SITE_URL} />

    <!-- Datos estructurados -->
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </slot>

  <LandingHeader />

  <main>
    <HeroSection />
    <ProblemSection />
    <FeaturesGrid />
    <HowItWorks />
    <DashboardPreview />
    <PricingSection />
    <FAQSection />
  </main>

  <LandingFooter />

  <FloatingWhatsApp />
</LandingLayout>
