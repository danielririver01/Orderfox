---
import PublicLayout from '../../layouts/PublicLayout.astro';
import MenuHeader from '../../components/menu/MenuHeader.astro';
import CategoryNav from '../../components/menu/CategoryNav.astro';
import ProductGrid from '../../components/menu/ProductGrid.astro';
import ProductDetail from '../../components/menu/ProductDetail.astro';
import CartButton from '../../components/cart/CartButton.astro';
import CartDrawer from '../../components/cart/CartDrawer.astro';
import CheckoutModal from '../../components/checkout/CheckoutModal.astro';
import SuccessModal from '../../components/checkout/SuccessModal.astro';
import Toast from '../../components/ui/Toast.astro';
import Footer from '../../components/ui/Footer.astro';
import { fetchMenu } from '../../lib/api';
import { menuCover, productImage } from '../../lib/brand';
import type { Restaurant, Category, Product } from '../../lib/types';

export async function getStaticPaths() {
  return [];
}

const slug = Astro.params.slug ?? '';

const tableParam = Astro.url.searchParams.get('table');
const tableId = tableParam ? (isNaN(parseInt(tableParam)) ? tableParam : parseInt(tableParam)) : null;

let restaurant: Restaurant | null = null;
let categories: Category[] = [];
let error: string | null = null;

try {
  const response = await fetchMenu(slug);
  if (response.success) {
    restaurant = response.data.restaurant;
    categories = response.data.categories;
    categories = categories.filter((cat) => cat.products && cat.products.length > 0);
  } else {
    error = 'No se pudo cargar el menú';
  }
} catch (e) {
  console.error('fetchMenu error:', e);
  error = 'Error al cargar el menú';
}

const isNotFound = !restaurant || !!error;
const errorTitle = error || 'Restaurante no encontrado';

const restaurantName = restaurant?.name ?? '';
const whatsappPhone = restaurant?.whatsapp_phone ?? '';
const restaurantId = restaurant?.id ?? 0;
const isOpen = restaurant?.is_open ?? false;
const orderingDisabled = restaurant?.ordering_disabled ?? false;
const ordering = isOpen && !orderingDisabled;
const showSearch = categories.length > 8;
const cover = restaurant ? menuCover(restaurant.cover_image) : null;
const estimatedTime = restaurant?.estimated_time ?? null;
const brandColor = restaurant?.brand_color ?? null;

let productsJson = '{}';
if (!isNotFound && restaurant) {
  const productsMap: Record<number, Product> = {};
  const fallbackImages: Record<string, string> = {};
  for (const cat of categories) {
    if (cat.products) {
      for (const product of cat.products) {
        productsMap[product.id] = product;
        if (!product.image_url) {
          fallbackImages[String(product.id)] = productImage(null, cat.name);
        }
      }
    }
  }
  productsJson = JSON.stringify({ productsMap, fallbackImages, restaurantId, whatsappPhone, tableId, brandColor, ordering });
}
---

{
  isNotFound ? (
    <PublicLayout title={errorTitle}>
      <main class="flex flex-1 flex-col items-center justify-center px-4 text-center">
        <h1 class="font-display text-2xl font-bold text-ink">{errorTitle}</h1>
        <p class="mt-2 text-ink-muted">{error}</p>
        <a href="/" class="mt-6 text-sm text-accent hover:text-accent-hover">Volver al inicio</a>
      </main>
    </PublicLayout>
  ) : (
    <PublicLayout title={`Menú - ${restaurantName}`}>
      <slot name="head">
        <meta property="og:title" content={`Menú - ${restaurantName}`} />
        <meta property="og:description" content="Descubre nuestro menú digital" />
        <meta property="og:type" content="website" />
      </slot>

      <Toast />

      <MenuHeader
        restaurantName={restaurantName}
        isOpen={isOpen}
        estimatedTime={estimatedTime}
        showSearch={showSearch}
        categories={categories}
      />

      {cover && (
        <div class="relative h-40 overflow-hidden md:h-52 lg:h-60">
          <img src={cover} alt="" class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-base via-base/25 to-transparent"></div>
        </div>
      )}

      <div class="mx-auto w-full max-w-6xl flex-1 lg:flex lg:gap-8 lg:px-6 lg:py-6">
        {/* Sidebar de categorías (desktop ≥900px) */}
        <aside class="hidden w-[220px] shrink-0 lg:block">
          <div class="sidebar-sticky sidebar-scroll overflow-y-auto pb-4">
            <CategoryNav categories={categories} />
            {ordering && <CartButton restaurantId={restaurantId} variant="sidebar" />}
          </div>
        </aside>

        {/* Contenido */}
        <main class="min-w-0 flex-1 px-4 py-4 lg:px-0 lg:py-0">
          {categories.map((cat) => (
            <section key={cat.id} id={`cat-${cat.id}`} class="mb-10">
              <h2 class="mb-4 font-display text-xl font-semibold text-ink">{cat.name}</h2>
              <ProductGrid products={cat.products} ordering={ordering} categoryName={cat.name} />
            </section>
          ))}

          <div id="no-results" class="hidden py-16 text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-card text-ink-faint">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </div>
            <p class="text-sm font-medium text-ink">No encontramos productos</p>
            <p class="mt-1 text-xs text-ink-faint">Prueba con otro término de búsqueda</p>
          </div>
        </main>
      </div>

      <Footer restaurantName={restaurantName} whatsappPhone={whatsappPhone} />

      <ProductDetail ordering={ordering} />
      {ordering && (
        <>
          <CartButton restaurantId={restaurantId} variant="fab" />
          <CartDrawer restaurantId={restaurantId} whatsappPhone={whatsappPhone} />
          <CheckoutModal restaurantSlug={slug} restaurantId={restaurantId} tableId={tableId} />
          <SuccessModal whatsappPhone={whatsappPhone} />
        </>
      )}

      <script id="page-data" type="application/json" set:html={productsJson}></script>

      <script>
        import { initMenuPage } from '../../scripts/menu-page';
        const pageDataEl = document.getElementById('page-data');
        if (pageDataEl) {
          initMenuPage(JSON.parse(pageDataEl.textContent));
        }
      </script>
    </PublicLayout>
  )
}