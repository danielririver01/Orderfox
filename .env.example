# Flask Configuration
SECRET_KEY=tu-clave-secreta-aqui-cambiala-en-produccion
JWT_SECRET_KEY=tu-jwt-secret-aqui-cambiala-en-produccion

# Database Configuration (MySQL)
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=mysql+pymysql://root:@localhost/orderfox

# Clerk Configuration (Authentication)
CLERK_PUBLISHABLE_KEY=tu-clerk-publishable-key
CLERK_SECRET_KEY=tu-clerk-secret-key
CLERK_JWT_ISSUER=https://tu-clerk-issuer.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_tu-clerk-webhook-secret

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Scanner IA Integration
SCANNER_IA_URL=http://localhost:3000
SERVICE_API_KEY=tu-api-key-servicio

# n8n Reward Workflow (Sorpresa Velzia)
N8N_REWARD_URL=http://n8n:5678/webhook/reward_immediate

# Copilot VZ (DeepSeek AI) Integration
DEEPSEEK_API_KEY=tu-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Mercado Pago Integration (Payments)
MP_ACCESS_TOKEN=tu-mercado-pago-access-token
MP_PUBLIC_KEY=tu-mercado-pago-public-key
MP_WEBHOOK_SECRET=tu-webhook-secret-de-mercado-pago

# Support & URL Configuration
SUPPORT_EMAIL=soporte@tudominio.com
SUPPORT_PHONE=+573000000000
BASE_URL=http://localhost:5000
ASTRO_BASE_URL=http://localhost:4321

FLASK_DEBUG=True

# Better Stack Error Tracking (Sentry-compatible DSN) — opcional, dejar vacío en desarrollo
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
